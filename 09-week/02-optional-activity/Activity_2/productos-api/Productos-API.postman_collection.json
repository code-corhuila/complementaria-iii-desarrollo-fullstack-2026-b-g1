    {
      "name": "6. ERROR 404 - GET producto inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Estructura del error', () => {",
              "  const e = pm.response.json();",
              "  pm.expect(e.status).to.eql(404);",
              "  pm.expect(e.error).to.eql('Not Found');",
              "  pm.expect(e.message).to.include('99999');",
              "  pm.expect(e.path).to.eql('/api/v1/products/99999');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/99999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "99999"
          ]
        }
      },
      "response": []
    },
    {
      "name": "7. ERROR 400 - POST con datos inválidos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Detalles de validación presentes', () => {",
              "  const e = pm.response.json();",
              "  pm.expect(e.status).to.eql(400);",
              "  pm.expect(e.details).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"description\": \"Producto con datos inválidos\",\n  \"price\": -5,\n  \"stock\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
